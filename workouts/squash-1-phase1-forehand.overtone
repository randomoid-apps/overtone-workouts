@include ../exercises/squash/forehand-ladder-volleys.overtone
@include ../exercises/squash/forehand-volley-heights.overtone
@include ../exercises/squash/ghosting-front-corners-with-drops.overtone
@include ../exercises/squash/forehand-drop-and-lob.overtone
@include ../exercises/squash/forehand-three-shot-sequence.overtone
@include ../exercises/squash/ghosting-six-points.overtone
@include ../exercises/squash/cool-down.overtone

## Finish
+0:01.5 That's session A. Next time, session B, the backhand. Well done.
